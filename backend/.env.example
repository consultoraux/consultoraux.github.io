# Copiá a backend/.env (NO subir ese archivo a GitHub)
PORT=3000
CONTACT_TO=maryorism6@gmail.com

# Creá una clave privada en https://resend.com/api-keys
RESEND_API_KEY=TU_CLAVE_RESEND_AQUI
# Solo para PRUEBAS hacia el email del dueño de la cuenta Resend:
RESEND_FROM=Consultora UX <onboarding@resend.dev>
# Para producción: dominio remitente verificado, p. ej.:
# RESEND_FROM=Consultora UX <hola@tudominio.com>

# Si frontend y backend están en dominios diferentes, listá aquí los orígenes
# permitidos separados por comas, SIN slash al final.
# Ejemplo: ALLOWED_ORIGINS=https://usuario.github.io,https://www.tudominio.com
ALLOWED_ORIGINS=

# Activar solo cuando corra detrás de un proxy confiable (por ej. Render).
TRUST_PROXY=false
